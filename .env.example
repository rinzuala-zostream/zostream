APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
ZOSTREAM_API_KEY=

OTP_REQUEST_MAX_ATTEMPTS=10
ADMIN_OTP_REQUEST_MAX_ATTEMPTS=6
ACCOUNT_DELETION_OTP_MAX_ATTEMPTS=6
OTP_VERIFY_MAX_ATTEMPTS=10
PLAYBACK_STREAM_TIMEOUT_SECONDS=500
PLAYBACK_INACTIVE_STREAM_RETENTION_HOURS=24
PLAYBACK_INACTIVE_STREAM_PRUNE_BATCH=1000
PLAYBACK_START_RATE_LIMIT=60
PLAYBACK_HEARTBEAT_RATE_LIMIT=20
PLAYBACK_HEARTBEAT_WRITE_INTERVAL=45
PLAYBACK_DEVICE_ACTIVITY_WRITE_INTERVAL=300
PLAYBACK_STOP_RATE_LIMIT=120
OFFLINE_DAILY_DOWNLOAD_LIMIT=3

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=zostream_api
DB_USERNAME=root
DB_PASSWORD=

# Optional dedicated analytics database. Defaults to the primary DB when unset.
ANALYTICS_DB_CONNECTION=mysql
ANALYTICS_DB_HOST=127.0.0.1
ANALYTICS_DB_PORT=3306
ANALYTICS_DB_DATABASE=zostream_analytics
ANALYTICS_DB_USERNAME=root
ANALYTICS_DB_PASSWORD=

# RECOMMENDER_PYTHON=/absolute/path/to/zostream/recommender/.venv/bin/python
RECOMMENDER_MODEL_GROUP=www-data
RECOMMENDER_RESPONSE_CACHE_FRESH_SECONDS=30
RECOMMENDER_RESPONSE_CACHE_STALE_SECONDS=300
RECOMMENDER_LIVE_SECTION_CACHE_SECONDS=60
RECOMMENDER_TRAIN_SOURCE=mysql
RECOMMENDER_TRAIN_TIMEOUT_SECONDS=3600
# Daily at 03:00. Any valid five-part cron expression is accepted.
RECOMMENDER_TRAIN_SCHEDULE="0 3 * * *"
RECOMMENDER_TRAIN_TIMEZONE=Asia/Kolkata
RECOMMENDER_BACKUP_PATTERN="/var/backups/mysql/zo_stream_db_*.sql.gz"
RECOMMENDER_BACKUP_MAX_AGE_HOURS=30
RECOMMENDER_BACKUP_RESTORE_TIMEOUT_SECONDS=1800

SESSION_DRIVER=database

# ZoStream ISP panel (/isp)
ISP_ADMIN_NAME="ISP Administrator"
ISP_ADMIN_EMAIL=
ISP_ADMIN_PASSWORD=
ZOSTREAM_OPERATOR_PERCENTAGE=20
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

RAZORPAY_ENV=SANDBOX
RAZORPAY_TEST_KEY_ID=
RAZORPAY_TEST_KEY_SECRET=
RAZORPAY_LIVE_KEY_ID=
RAZORPAY_LIVE_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Cashfree (used by the ISP payment checkout)
CASHFREE_ENV=SANDBOX
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_SANDBOX_CLIENT_ID=
CASHFREE_SANDBOX_CLIENT_SECRET=

ADS_UPLOAD_DISK=public
ADS_UPLOAD_DIRECTORY=ads/submissions
ADS_DEFAULT_COUNTRY_CODE=91
# Optional approved WhatsApp template. Body params: reference, amount/currency, payment URL.
# URL button parameter: the 48-character payment token.
ADS_PAYMENT_WHATSAPP_TEMPLATE=
ADS_PAYMENT_WHATSAPP_TEMPLATE_LANGUAGE=en

AMAZON_IAP_SHARED_SECRET=
AMAZON_IAP_SANDBOX=false
AMAZON_IAP_PARENT_SKU=zostream_sub
AMAZON_IAP_WEEK_SKU=zostream.week
AMAZON_IAP_MONTH_SKU=zostream.month
AMAZON_IAP_FOUR_MONTHS_SKU=zostream.4months
AMAZON_IAP_SIX_MONTHS_SKU=zostream.6months
AMAZON_IAP_YEAR_SKU=zostream.year

WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v22.0
WHATSAPP_WIFI_REMINDER_TEMPLATE=zostream_wifi_reminder
WHATSAPP_WIFI_REMINDER_LANGUAGE=en

VITE_APP_NAME="${APP_NAME}"
