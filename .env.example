APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
ZOSTREAM_API_KEY=

OTP_REQUEST_MAX_ATTEMPTS=10
ADMIN_OTP_REQUEST_MAX_ATTEMPTS=6
ACCOUNT_DELETION_OTP_MAX_ATTEMPTS=6
OTP_VERIFY_MAX_ATTEMPTS=10
PLAYBACK_STREAM_TIMEOUT_SECONDS=500
PLAYBACK_INACTIVE_STREAM_RETENTION_HOURS=24
PLAYBACK_INACTIVE_STREAM_PRUNE_BATCH=1000
PLAYBACK_START_RATE_LIMIT=60
PLAYBACK_HEARTBEAT_RATE_LIMIT=20
PLAYBACK_HEARTBEAT_WRITE_INTERVAL=45
PLAYBACK_DEVICE_ACTIVITY_WRITE_INTERVAL=300
PLAYBACK_STOP_RATE_LIMIT=120

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=zostream_api
DB_USERNAME=root
DB_PASSWORD=

# RECOMMENDER_PYTHON=/absolute/path/to/zostream/recommender/.venv/bin/python
RECOMMENDER_TRAIN_SOURCE=mysql
RECOMMENDER_TRAIN_TIMEOUT_SECONDS=3600
# Daily at 03:00. Any valid five-part cron expression is accepted.
RECOMMENDER_TRAIN_SCHEDULE="0 3 * * *"
RECOMMENDER_TRAIN_TIMEZONE=Asia/Kolkata
RECOMMENDER_BACKUP_PATTERN="/var/backups/mysql/zo_stream_db_*.sql.gz"
RECOMMENDER_BACKUP_MAX_AGE_HOURS=30
RECOMMENDER_BACKUP_RESTORE_TIMEOUT_SECONDS=1800

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

RAZORPAY_WEBHOOK_SECRET=

AMAZON_IAP_SHARED_SECRET=
AMAZON_IAP_SANDBOX=false
AMAZON_IAP_PARENT_SKU=zostream_sub
AMAZON_IAP_WEEK_SKU=zostream.week
AMAZON_IAP_MONTH_SKU=zostream.month
AMAZON_IAP_FOUR_MONTHS_SKU=zostream.4months
AMAZON_IAP_SIX_MONTHS_SKU=zostream.6months
AMAZON_IAP_YEAR_SKU=zostream.year

WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v22.0

VITE_APP_NAME="${APP_NAME}"
